# SPDX-License-Identifier: GPL-2.0-only
# MT76 MT7925 Out-of-tree DKMS Build Makefile
#
# This Makefile wraps the in-tree Makefile for out-of-tree DKMS builds.
# It sets the necessary CONFIG_ options that would normally come from Kconfig.

# Kernel build directory
KDIR ?= /lib/modules/$(shell uname -r)/build

# Required CONFIG options for MT7925 PCIe
ccflags-y += -DCONFIG_MT76_CORE=m
ccflags-y += -DCONFIG_MT76_CONNAC_LIB=m
ccflags-y += -DCONFIG_MT792x_LIB=m
ccflags-y += -DCONFIG_MT7925_COMMON=m
ccflags-y += -DCONFIG_MT7925E=m
ccflags-y += -DCONFIG_PCI=y

# Optional: Enable ACPI SAR support if available
ccflags-y += -DCONFIG_ACPI=y

# Optional: Enable testmode if you want it
# ccflags-y += -DCONFIG_NL80211_TESTMODE=y

# Set config options as module (=m)
CONFIG_MT76_CORE := m
CONFIG_MT76_CONNAC_LIB := m
CONFIG_MT792x_LIB := m
CONFIG_MT7925_COMMON := m
CONFIG_MT7925E := m

# Include original Makefile
include $(src)/Makefile.orig

all:
	$(MAKE) -C $(KDIR) M=$(PWD) modules

clean:
	$(MAKE) -C $(KDIR) M=$(PWD) clean

install:
	$(MAKE) -C $(KDIR) M=$(PWD) modules_install

.PHONY: all clean install
