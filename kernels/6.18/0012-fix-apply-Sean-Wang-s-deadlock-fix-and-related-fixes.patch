From 73987c1e3f17c0bffec20accc7322dc01a305561 Mon Sep 17 00:00:00 2001
From: Zac <zac@zacbowling.com>
Date: Tue, 20 Jan 2026 10:16:40 -0800
Subject: [PATCH 12/12] fix: apply Sean Wang's deadlock fix and related fixes
 for v6

This commit applies critical fixes for v6 based on Sean Wang's feedback:

1. Apply Sean's deadlock fix to roc_abort_sync:
   - test_and_clear_bit() moved before timer_delete_sync()
   - Changed cancel_work_sync() to cancel_work()
   - This prevents deadlock when caller holds mutex

2. Remove mutex wrapper from pci.c suspend:
   - With Sean's fix, roc_abort_sync is safe without mutex

3. Fix mt7921_regd_set_6ghz_power_type deadlock:
   - Function is called from sta_add/remove which holds mutex
   - Removed nested mutex acquisition that caused deadlock

4. Update sta_remove to use roc_abort_sync:
   - Now safe with Sean's cancel_work() change
---
 .../net/wireless/mediatek/mt76/mt7921/main.c    |  5 +++--
 .../net/wireless/mediatek/mt76/mt7925/main.c    | 17 ++++++++++-------
 drivers/net/wireless/mediatek/mt76/mt7925/pci.c |  2 --
 3 files changed, 13 insertions(+), 11 deletions(-)

diff --git a/drivers/net/wireless/mediatek/mt76/mt7921/main.c b/drivers/net/wireless/mediatek/mt76/mt7921/main.c
index 3b56bc569fd4..ccc5d0a794c8 100644
--- a/drivers/net/wireless/mediatek/mt76/mt7921/main.c
+++ b/drivers/net/wireless/mediatek/mt76/mt7921/main.c
@@ -787,11 +787,12 @@ mt7921_regd_set_6ghz_power_type(struct ieee80211_vif *vif, bool is_add)
 	struct mt792x_dev *dev = phy->dev;
 	u32 valid_vif_num = 0;
 
-	mt792x_mutex_acquire(dev);
+	/* Note: caller (mt7921_mac_sta_add/remove via mt76_sta_add/remove)
+	 * already holds dev->mt76.mutex, so we must not acquire it here.
+	 */
 	ieee80211_iterate_active_interfaces(mt76_hw(dev),
 					    IEEE80211_IFACE_ITER_RESUME_ALL,
 					    mt7921_calc_vif_num, &valid_vif_num);
-	mt792x_mutex_release(dev);
 
 	if (valid_vif_num > 1) {
 		phy->power_type = MT_AP_DEFAULT;
diff --git a/drivers/net/wireless/mediatek/mt76/mt7925/main.c b/drivers/net/wireless/mediatek/mt76/mt7925/main.c
index b8197cb83692..83d43bdb749b 100644
--- a/drivers/net/wireless/mediatek/mt76/mt7925/main.c
+++ b/drivers/net/wireless/mediatek/mt76/mt7925/main.c
@@ -467,12 +467,16 @@ void mt7925_roc_abort_sync(struct mt792x_dev *dev)
 {
 	struct mt792x_phy *phy = &dev->phy;
 
+	if (!test_and_clear_bit(MT76_STATE_ROC, &phy->mt76->state))
+		return;
+
 	timer_delete_sync(&phy->roc_timer);
-	cancel_work_sync(&phy->roc_work);
-	if (test_and_clear_bit(MT76_STATE_ROC, &phy->mt76->state))
-		ieee80211_iterate_interfaces(mt76_hw(dev),
-					     IEEE80211_IFACE_ITER_RESUME_ALL,
-					     mt7925_roc_iter, (void *)phy);
+
+	cancel_work(&phy->roc_work);
+
+	ieee80211_iterate_interfaces(mt76_hw(dev),
+				     IEEE80211_IFACE_ITER_RESUME_ALL,
+				     mt7925_roc_iter, (void *)phy);
 }
 EXPORT_SYMBOL_GPL(mt7925_roc_abort_sync);
 
@@ -1270,8 +1274,7 @@ static void mt7925_mac_link_sta_remove(struct mt76_dev *mdev,
 	if (!mlink)
 		return;
 
-	/* Async abort - caller already holds mutex */
-	mt7925_roc_abort_async(dev);
+	mt7925_roc_abort_sync(dev);
 
 	mt76_connac_free_pending_tx_skbs(&dev->pm, &mlink->wcid);
 	mt76_connac_pm_wake(&dev->mphy, &dev->pm);
diff --git a/drivers/net/wireless/mediatek/mt76/mt7925/pci.c b/drivers/net/wireless/mediatek/mt76/mt7925/pci.c
index 47d944f1d6ba..ee75b21da511 100644
--- a/drivers/net/wireless/mediatek/mt76/mt7925/pci.c
+++ b/drivers/net/wireless/mediatek/mt76/mt7925/pci.c
@@ -454,9 +454,7 @@ static int mt7925_pci_suspend(struct device *device)
 	cancel_delayed_work_sync(&pm->ps_work);
 	cancel_work_sync(&pm->wake_work);
 
-	mt792x_mutex_acquire(dev);
 	mt7925_roc_abort_sync(dev);
-	mt792x_mutex_release(dev);
 
 	err = mt792x_mcu_drv_pmctrl(dev);
 	if (err < 0)
-- 
2.52.0

